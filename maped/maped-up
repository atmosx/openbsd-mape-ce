#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || exec doas "$0" "$@"

CONF="${1:-/etc/maped.conf}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
CONFIG_TEXT=$("$SCRIPT_DIR/maped-config" "$CONF")
eval "$CONFIG_TEXT"
MAPED_SNAPSHOT="${2:-}"
export MAPED_SNAPSHOT

DERIVE_COMMAND="${MAPED_DERIVE:-${DERIVE_COMMAND:-/usr/local/libexec/maped/maped-derive}}"
[ -x "$DERIVE_COMMAND" ] || DERIVE_COMMAND="$SCRIPT_DIR/maped-derive"
MAPED_PEER_IPV4="${MAPED_PEER_IPV4:-${MAPE_PEER_IPV4:-0.0.0.1}}"
IFCONFIG="${IFCONFIG:-ifconfig}"
PFCTL="${PFCTL:-pfctl}"
ROUTE="${ROUTE:-route}"

export PD_PREFIX PD_IF LEASE_FILE LEASE_IF WAN_IF DHCP6LEASECTL
export MAP_IPV6_PREFIX MAP_IPV6_PLEN MAP_IPV4_PREFIX MAP_IPV4_PLEN EA_LEN PSID_OFFSET BR_IPV6

eval "$("$DERIVE_COMMAND")"

echo "Derived MAP-E values:"
echo "  PD_PREFIX=$PD_PREFIX"
echo "  CE_IPV6=$CE_IPV6"
echo "  MAPE_IPV4=$MAPE_IPV4"
echo "  BR_IPV6=$BR_IPV6"
echo "  PSID_OFFSET=$PSID_OFFSET"
echo "  PSID_LEN=$PSID_LEN"
echo "  PSID=$PSID"

# Resolve and validate the MTU before changing interfaces or PF rules.
if ! WAN_CONFIG=$("$IFCONFIG" "$WAN_IF"); then
	echo "$WAN_IF does not exist" >&2
	exit 1
fi
GIF_MTU="${GIF_MTU:-auto}"
if [ "$GIF_MTU" = auto ]; then
	WAN_MTU=$(printf '%s\n' "$WAN_CONFIG" | awk '
	    NR == 1 { for (i = 1; i < NF; i++)
	        if ($i == "mtu") { print $(i + 1); exit } }')
	case "$WAN_MTU" in
	""|*[!0-9]*|0*|??????*)
		echo "cannot determine MTU for $WAN_IF" >&2
		exit 1 ;;
	esac
	GIF_MTU=$((WAN_MTU - 40))
fi
case "$GIF_MTU" in
*[!0-9]*|0*) GIF_MTU=invalid ;;
esac
case "$GIF_MTU" in
????) ;;
*) echo "GIF_MTU must be auto or an integer from 1280 to 8192" >&2
   exit 1 ;;
esac
if [ "$GIF_MTU" -lt 1280 ] || [ "$GIF_MTU" -gt 8192 ]; then
	echo "GIF_MTU $GIF_MTU is outside the gif(4) range 1280..8192" >&2
	exit 1
fi
TCP_MSS=$((GIF_MTU - 40))
echo "  GIF_MTU=$GIF_MTU TCP_MSS=$TCP_MSS"

# Never replace a default route owned by another service. Check before any
# mutations; when repairing our own route, require both interface and peer.
DEFAULT=$("$ROUTE" -n get -inet default 2>/dev/null) || DEFAULT=""
if [ -n "$DEFAULT" ]; then
	DEFAULT_IF=$(printf '%s\n' "$DEFAULT" | awk '$1 == "interface:" { print $2; exit }')
	DEFAULT_GW=$(printf '%s\n' "$DEFAULT" | awk '$1 == "gateway:" { print $2; exit }')
	if [ "$DEFAULT_IF" != "$GIF_IF" ] || [ "$DEFAULT_GW" != "$MAPED_PEER_IPV4" ]; then
		echo "refusing to replace an unowned IPv4 default route" >&2
		exit 1
	fi
fi

if ! "$IFCONFIG" "$WAN_IF" | grep -q "$CE_IPV6"; then
	"$IFCONFIG" "$WAN_IF" inet6 alias "$CE_IPV6" prefixlen 128
fi

# Delete the verified owned route while its interface still exists.
# Destroying the GIF removes its routes on OpenBSD, invalidating DEFAULT.
if [ -n "$DEFAULT" ]; then
	"$ROUTE" delete -inet default -ifp "$GIF_IF" "$MAPED_PEER_IPV4"
fi
if "$IFCONFIG" "$GIF_IF" >/dev/null 2>&1; then
	"$IFCONFIG" "$GIF_IF" destroy
fi

"$IFCONFIG" "$GIF_IF" create
"$IFCONFIG" "$GIF_IF" tunnel "$CE_IPV6" "$BR_IPV6"
"$IFCONFIG" "$GIF_IF" inet "$MAPE_IPV4" "$MAPED_PEER_IPV4" netmask 255.255.255.255
"$IFCONFIG" "$GIF_IF" mtu "$GIF_MTU"
"$IFCONFIG" "$GIF_IF" up

mkdir -p "$(dirname "$PF_ANCHOR_FILE")"
PF_ANCHOR_TMP="$(mktemp "$PF_ANCHOR_FILE.XXXXXXXXXX")"
trap 'rm -f "$PF_ANCHOR_TMP"' EXIT

cat > "$PF_ANCHOR_TMP" <<EOF
match out on $GIF_IF inet proto tcp flags S/SA scrub (max-mss $TCP_MSS)

match out on $GIF_IF inet from ($GIF_IF) to any nat-to ($GIF_IF) map-e-portset $PSID_OFFSET/$PSID_LEN/$PSID
match out on $GIF_IF inet from $LAN_NET to any nat-to ($GIF_IF) map-e-portset $PSID_OFFSET/$PSID_LEN/$PSID

pass out quick on $WAN_IF inet6 proto 4 from $CE_IPV6 to $BR_IPV6 keep state
pass in  quick on $WAN_IF inet6 proto 4 from $BR_IPV6 to $CE_IPV6 keep state

# Return traffic is admitted by PF state. The parent ruleset must explicitly
# permit any unsolicited inbound services; never open all CE ports here.
pass out quick on $GIF_IF inet from ($GIF_IF) to any keep state
EOF

"$PFCTL" -a mape -nf "$PF_ANCHOR_TMP"
"$PFCTL" -a mape -f "$PF_ANCHOR_TMP"
mv "$PF_ANCHOR_TMP" "$PF_ANCHOR_FILE"
trap - EXIT

"$ROUTE" add -inet default -ifp "$GIF_IF" "$MAPED_PEER_IPV4"

echo "MAP-E is up"
"$IFCONFIG" "$GIF_IF"
"$ROUTE" -n show -inet | grep default || true
"$PFCTL" -a mape -sr
