use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin";
use Maped qw(parse_lease complete_lease derive_mape command);

sub diex { die "maped-derive: @_\n"; }

sub find_pd_prefix {
	my ($lease) = @_;
	return $lease->{PD_PREFIX} if $ENV{MAPED_SNAPSHOT};
	return $ENV{PD_PREFIX} if $ENV{PD_PREFIX};
	return $lease->{PD_PREFIX} if $lease->{PD_PREFIX};

	if ($ENV{LEASE_FILE} && -r $ENV{LEASE_FILE}) {
		open my $fh, "<", $ENV{LEASE_FILE} or diex("cannot read $ENV{LEASE_FILE}: $!");
		while (my $line = <$fh>) {
			if ($line =~ /^\s*ia_pd\s+\d+\s+([0-9a-fA-F:]+)\s+(\d{1,3})\b/ ||
			    $line =~ /^\s*IA_PD\s+\d+:\s+([0-9a-fA-F:]+)\/(\d{1,3})\b/) {
				return "$1/$2";
			}
		}
	}

	if ($ENV{PD_IF}) {
		open my $fh, "-|", "ifconfig", $ENV{PD_IF} or diex("cannot run ifconfig $ENV{PD_IF}: $!");
		while (my $line = <$fh>) {
			if ($line =~ /\binet6\s+([0-9a-fA-F:]+)\s+prefixlen\s+(\d+)/) {
				my ($addr, $plen) = ($1, $2);
				next if $addr =~ /^(?:fe80:|fd)/i;
				return "$addr/$plen";
			}
		}
	}

	diex("could not find delegated prefix; set PD_PREFIX=.../... in /etc/maped.conf for testing");
}

sub read_dhcp6leased {
	if ($ENV{MAPED_SNAPSHOT}) {
		open my $fh, '<', $ENV{MAPED_SNAPSHOT} or diex("snapshot: $!");
		local $/;
		my %lease = parse_lease(<$fh>);
		diex("incomplete snapshot") unless complete_lease(\%lease);
		return %lease;
	}
	if ($ENV{LEASE_FILE} && -r $ENV{LEASE_FILE}) {
		open my $fh, '<', $ENV{LEASE_FILE} or diex("lease: $!");
		local $/;
		my %lease = parse_lease(<$fh>);
		return %lease if complete_lease(\%lease);
	}
	my $iface = $ENV{LEASE_IF} || $ENV{WAN_IF};
	return () unless $iface;
	my ($rc, $text) = command(30, 1024 * 1024,
	    $ENV{DHCP6LEASECTL} || 'dhcp6leasectl', '-l', $iface);
	diex("cannot read live lease: $text") if $rc;
	return parse_lease($text);
}

my %lease = read_dhcp6leased();
$lease{PD_PREFIX} = find_pd_prefix(\%lease);
my %derived = derive_mape(\%lease, \%ENV);

for my $key (qw(PD_PREFIX BR_IPV6 MAP_IPV6_PREFIX MAP_IPV6_PLEN MAP_IPV4_PREFIX
    MAP_IPV4_PLEN EA_LEN CE_IPV6 MAPE_IPV4 EA_PSID_LEN EA_PSID PSID_LEN PSID PSID_OFFSET)) {
	next unless defined $derived{$key} && $derived{$key} ne "";
	print "$key='$derived{$key}'\n";
}
