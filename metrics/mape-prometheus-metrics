#!/bin/sh
#
# Emit Prometheus textfile metrics for an OpenBSD MAP-E CE router.
#
# This script intentionally performs the privileged collection as a short-lived
# root process and writes a static textfile for a non-root exporter to serve.

set -eu

PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

CONF="/etc/maped.conf"
OUT="/var/prometheus/textfile/mape.prom"
WAN_IF="pppoe0"
LEASE_IF=""
GIF_IF="gif0"
PF_ANCHOR="mape"
CLI_WAN_IF=""
CLI_GIF_IF=""

usage() {
	cat <<EOF
usage: mape-prometheus-metrics [options]

options:
  -c file        maped config file (default: /etc/maped.conf)
  -o file        output metrics file (default: /var/prometheus/textfile/mape.prom)
  -w interface   WAN interface fallback (default: pppoe0)
  -g interface   gif interface fallback (default: gif0)
  -a anchor      PF anchor name (default: mape)
  -h             show this help

The output file is replaced atomically.
EOF
	exit 2
}

need_arg() {
	[ "$#" -ge 2 ] || usage
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	-c)
		need_arg "$@"
		CONF="$2"
		shift 2
		;;
	-o)
		need_arg "$@"
		OUT="$2"
		shift 2
		;;
	-w)
		need_arg "$@"
		CLI_WAN_IF="$2"
		shift 2
		;;
	-g)
		need_arg "$@"
		CLI_GIF_IF="$2"
		shift 2
		;;
	-a)
		need_arg "$@"
		PF_ANCHOR="$2"
		shift 2
		;;
	-h|--help)
		usage
		;;
	*)
		usage
		;;
	esac
done

if [ -r "$CONF" ]; then
	# shellcheck disable=SC1090
	. "$CONF"
fi

WAN_IF="${WAN_IF:-pppoe0}"
LEASE_IF="${LEASE_IF:-$WAN_IF}"
GIF_IF="${GIF_IF:-gif0}"
[ "$CLI_WAN_IF" = "" ] || WAN_IF="$CLI_WAN_IF"
[ "$CLI_GIF_IF" = "" ] || GIF_IF="$CLI_GIF_IF"
PF_ANCHOR_FILE="${PF_ANCHOR_FILE:-/etc/pf.anchors/$PF_ANCHOR}"
MAPED_DERIVE="${MAPED_DERIVE:-${DERIVE_COMMAND:-/usr/local/libexec/maped/maped-derive}}"

OUT_DIR="$(dirname "$OUT")"
TMP="$OUT.$$"
mkdir -p "$OUT_DIR"
trap 'rm -f "$TMP"' EXIT

run() {
	"$@" 2>/dev/null || true
}

metric_name_label() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9_]/_/g'
}

bool_grep() {
	text="$1"
	pattern="$2"
	if printf '%s\n' "$text" | grep -q "$pattern"; then
		printf '1'
	else
		printf '0'
	fi
}

pf_total() {
	key="$1"
	printf '%s\n' "$PF_INFO" | awk -v key="$key" '
	    $1 == key { print $2; found = 1 }
	    END { if (!found) print 0 }
	'
}

pf_state_value() {
	key="$1"
	printf '%s\n' "$PF_INFO" | awk -v key="$key" '
	    index($0, key) { print $NF; found = 1 }
	    END { if (!found) print 0 }
	'
}

emit_help_type() {
	name="$1"
	help="$2"
	type="$3"
	printf '# HELP %s %s\n' "$name" "$help"
	printf '# TYPE %s %s\n' "$name" "$type"
}

emit_gauge() {
	name="$1"
	value="$2"
	printf '%s %s\n' "$name" "$value"
}

emit_labeled_gauge() {
	name="$1"
	label="$2"
	value="$3"
	printf '%s{%s} %s\n' "$name" "$label" "$value"
}

PF_INFO="$(run pfctl -si)"
PF_QUEUES="$(run pfctl -sq -v)"
PF_MMAPE="$(run pfctl -a "$PF_ANCHOR" -sr)"
IF_GIF="$(run ifconfig "$GIF_IF")"
IF_WAN="$(run ifconfig "$WAN_IF")"
LEASE="$(run dhcp6leasectl -l "$LEASE_IF")"
ROUTES="$(run netstat -rn)"
DERIVE="$(run "$MAPED_DERIVE")"
ANCHOR_FILE_CONTENT=""
[ -r "$PF_ANCHOR_FILE" ] && ANCHOR_FILE_CONTENT="$(cat "$PF_ANCHOR_FILE")"

{
	printf '# Generated by mape-prometheus-metrics at %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

	emit_help_type maped_up "Whether rcctl reports maped as running." gauge
	if rcctl check maped >/dev/null 2>&1; then
		emit_gauge maped_up 1
	else
		emit_gauge maped_up 0
	fi

	emit_help_type dhcp6leased_up "Whether rcctl reports dhcp6leased as running." gauge
	if rcctl check dhcp6leased >/dev/null 2>&1; then
		emit_gauge dhcp6leased_up 1
	else
		emit_gauge dhcp6leased_up 0
	fi

	emit_help_type dhcp6leased_mape_bound "Whether dhcp6leasectl reports MAP-E lease data for the lease interface." gauge
	emit_gauge dhcp6leased_mape_bound "$(bool_grep "$LEASE" 'MAP-E')"

	emit_help_type mape_gif_up "Whether the MAP-E gif interface has the UP flag." gauge
	emit_gauge mape_gif_up "$(bool_grep "$IF_GIF" 'flags=.*UP')"

	emit_help_type mape_gif_running "Whether the MAP-E gif interface has the RUNNING flag." gauge
	emit_gauge mape_gif_running "$(bool_grep "$IF_GIF" 'flags=.*RUNNING')"

	emit_help_type pppoe_session_up "Whether the PPPoE interface reports active status." gauge
	emit_gauge pppoe_session_up "$(bool_grep "$IF_WAN" 'status: active')"

	emit_help_type mape_anchor_portset_present "Whether the live PF MAP-E anchor contains a map-e-portset rule." gauge
	emit_gauge mape_anchor_portset_present "$(bool_grep "$PF_MMAPE" 'map-e-portset')"

	emit_help_type mape_anchor_file_portset_present "Whether the generated PF anchor file contains a map-e-portset rule." gauge
	emit_gauge mape_anchor_file_portset_present "$(bool_grep "$ANCHOR_FILE_CONTENT" 'map-e-portset')"

	emit_help_type mape_default_route_v4 "Whether the IPv4 default route points at the MAP-E gif interface." gauge
	if printf '%s\n' "$ROUTES" | awk -v gif="$GIF_IF" '$1 == "default" && $NF == gif { found = 1 } END { exit found ? 0 : 1 }'; then
		emit_gauge mape_default_route_v4 1
	else
		emit_gauge mape_default_route_v4 0
	fi

	emit_help_type mape_default_route_v6 "Whether the IPv6 default route points at the WAN interface." gauge
	if printf '%s\n' "$ROUTES" | awk -v wan="$WAN_IF" '$1 == "default" && $NF == wan { found = 1 } END { exit found ? 0 : 1 }'; then
		emit_gauge mape_default_route_v6 1
	else
		emit_gauge mape_default_route_v6 0
	fi

	emit_help_type mape_derive_ok "Whether maped-derive completed and produced CE IPv6 and MAP-E IPv4 values." gauge
	if printf '%s\n' "$DERIVE" | grep -q "CE_IPV6=" && printf '%s\n' "$DERIVE" | grep -q "MAPE_IPV4="; then
		emit_gauge mape_derive_ok 1
	else
		emit_gauge mape_derive_ok 0
	fi

	emit_help_type pf_states "Current PF state table entries." gauge
	emit_gauge pf_states "$(pf_state_value 'current entries')"

	emit_help_type pf_halfopen_tcp "Current PF half-open TCP states." gauge
	emit_gauge pf_halfopen_tcp "$(pf_state_value 'half-open tcp')"

	emit_help_type pf_counter_total "PF cumulative counters from pfctl -si." counter
	for key in bad-offset fragment short normalize memory bad-timestamp congestion ip-option proto-cksum state-mismatch state-insert state-limit src-limit synproxy translate no-route; do
		label_key="$(metric_name_label "$key")"
		emit_labeled_gauge pf_counter_total "counter=\"$label_key\"" "$(pf_total "$key")"
	done

	printf '%s\n' "$PF_QUEUES" | awk '
	    /^queue / {
	        queue = $2
	        next
	    }
	    /pkts:/ && /dropped pkts:/ {
	        pkts = $3 + 0
	        bytes = $5 + 0
	        drops = $8 + 0
	        drop_bytes = $10 + 0
	        printf "pf_queue_packets_total{queue=\"%s\"} %s\n", queue, pkts
	        printf "pf_queue_bytes_total{queue=\"%s\"} %s\n", queue, bytes
	        printf "pf_queue_dropped_packets_total{queue=\"%s\"} %s\n", queue, drops
	        printf "pf_queue_dropped_bytes_total{queue=\"%s\"} %s\n", queue, drop_bytes
	        next
	    }
	    /qlength:/ {
	        q = $3
	        gsub(/\[/, "", q)
	        split(q, a, "/")
	        limit = $4
	        gsub(/\]/, "", limit)
	        printf "pf_queue_length{queue=\"%s\"} %s\n", queue, a[1] + 0
	        printf "pf_queue_limit{queue=\"%s\"} %s\n", queue, limit + 0
	        next
	    }
	'
} >"$TMP"

chmod 0644 "$TMP"
mv "$TMP" "$OUT"
trap - EXIT
