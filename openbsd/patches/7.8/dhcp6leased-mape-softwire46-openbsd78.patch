===================================================================
--- /dev/null	Thu Jan  1 00:00:00 1970
+++ sbin/dhcp6leased/s46.c	Fri May 15 12:29:53 2026
@@ -0,0 +1,267 @@
+/*	$OpenBSD$ */
+
