use strict;
use warnings;
use Getopt::Std;
use FindBin;
use lib "$FindBin::Bin", "$FindBin::Bin/../libexec/maped";
use Maped qw(command status_text parse_lease complete_lease lease_text parse_config config_text live_lease effective_mtu has_ipv6 runtime_mismatch);
use MapedStatus;
use Fcntl qw(:flock);
use Time::HiRes qw(clock_gettime CLOCK_MONOTONIC);
use File::Temp qw(tempfile);
use File::Path qw(make_path);
use POSIX qw(setsid strftime);
use Sys::Syslog qw(:standard :macros);

my @orig_argv = @ARGV;
my %opt;
getopts("1dfi:l:p", \%opt) or usage();

my $once = $opt{"1"} ? 1 : 0;
my $daemon = $opt{d} ? 1 : 0;
my $foreground = $opt{f} ? 1 : 0;
my $force_poll = $opt{p} ? 1 : 0;
my $interval = defined $opt{i} ? $opt{i} : 30;
my $log_level = lc($opt{l} // "");
my $conf = $ARGV[0] || "/etc/maped.conf";
usage() if @ARGV > 1;
require Cwd;
$conf = Cwd::abs_path($conf) // die "maped: configuration not found\n";

usage() if $daemon && $foreground;
usage() if $interval !~ /^\d+$/ || $interval < 1;

if ($> != 0) {
	exec "doas", $0, @orig_argv or die "maped: cannot exec doas: $!\n";
}

my %conf = read_conf($conf);
my $state_dir = $conf{MAPED_STATE_DIR} || $conf{MAPE_STATE_DIR} || "/var/db/maped";
my $state_file = $conf{MAPED_STATE_FILE} || $conf{MAPE_STATE_FILE} || "$state_dir/lease.state";
my $maped_up = resolve_command($conf{MAPED_UP} || "/usr/local/libexec/maped/maped-up",
    "/usr/local/libexec/maped/maped-up");
my $dhcp6leasectl = resolve_command($conf{DHCP6LEASECTL} || "dhcp6leasectl",
    "/usr/sbin/dhcp6leasectl");
my $ifconfig = resolve_command($conf{IFCONFIG} || "ifconfig", "/sbin/ifconfig");
my $pfctl = resolve_command($conf{PFCTL} || "pfctl", "/sbin/pfctl");
my $maped_down = resolve_command($conf{MAPED_DOWN} || "/usr/local/libexec/maped/maped-down",
    "/usr/local/libexec/maped/maped-down");
my $maped_derive = resolve_command($conf{MAPED_DERIVE} || "/usr/local/libexec/maped/maped-derive",
    "/usr/local/libexec/maped/maped-derive");
my $route = resolve_command($conf{ROUTE} || "route", "/sbin/route");
my $applied_file = "$state_dir/applied.conf";
my $lease_deadline;
my ($reporter, $report_plan, $last_active_plan, $confirmed_at, $expires_at);
my ($report_status, $report_reason) = ('initializing', 'awaiting live confirmation');
$conf{IFCONFIG} = $ifconfig;
$conf{PFCTL} = $pfctl;
$conf{ROUTE} = $route;
$conf{MAPED_DERIVE} = $maped_derive;
my %log_rank = (debug => 0, info => 1, warn => 2);
$log_level = lc($conf{MAPED_LOG_LEVEL} || $conf{MAPE_LOG_LEVEL} || "info") if $log_level eq "";
usage() unless exists $log_rank{$log_level};
my $have_kqueue = $force_poll ? 0 : load_kqueue();

make_path($state_dir, {mode => 0700}) unless -d $state_dir;
my @state_stat = stat($state_dir);
die "maped: insecure state directory\n" if $state_stat[4] != 0 || ($state_stat[2] & 0022);
open my $lock, '>>', "$state_dir/lock" or die "maped: lock: $!";
flock($lock, LOCK_EX | LOCK_NB) or die "maped: another instance owns $state_dir\n";

# History is reporting only. Refuse corrupt history rather than silently lose it.
$reporter = MapedStatus->new("$state_dir/status.json");

# A missing Perl sandbox must fail synchronously, before -d reports success.
if ($^O eq 'openbsd') {
	my $loaded = eval {
		require OpenBSD::Pledge;
		OpenBSD::Pledge->import(qw(pledge));
		require OpenBSD::Unveil;
		OpenBSD::Unveil->import(qw(unveil));
		1;
	};
	die "maped: pledge/unveil unavailable on OpenBSD: $@\n" unless $loaded;
}

if ($daemon) {
	daemonize();
	openlog("maped", "pid", LOG_DAEMON);
	log_info(startup_message());
} else {
	openlog("maped", "pid,perror", LOG_DAEMON);
}

sandbox_parent();
publish_status();

exit(cycle() ? 0 : 1) if $once;
cycle();

while (1) {
	wait_for_change();
	cycle();
}

sub usage {
	print STDERR "usage: maped [-1] [-d|-f] [-p] [-i seconds] [-l info|warn|debug] [config]\n";
	exit 2;
}

sub startup_message {
	my $backend = $have_kqueue && $conf{LEASE_FILE} ?
	    "kqueue on $conf{LEASE_FILE}; health check every ${interval}s" :
	    "polling every ${interval}s";
	return "started; using $conf (restart to reload); $backend";
}

sub daemonize {
	chdir "/" or die "maped: chdir /: $!\n";
	defined(my $pid = fork) or die "maped: fork: $!\n";
	exit 0 if $pid;
	setsid() or die "maped: setsid: $!\n";
	defined($pid = fork) or die "maped: fork: $!\n";
	exit 0 if $pid;

	open STDIN, "<", "/dev/null" or die "maped: stdin: $!\n";
	open STDOUT, ">", "/dev/null" or die "maped: stdout: $!\n";
	open STDERR, ">", "/dev/null" or die "maped: stderr: $!\n";
}

sub read_conf {
	my ($path) = @_;
	open my $fh, '<', $path or die "maped: cannot read $path: $!";
	local $/;
	return parse_config(<$fh>);
}

sub resolve_command {
	my ($cmd, $fallback) = @_;
	return $cmd if $cmd =~ m{/};
	return $fallback if defined $fallback && -x $fallback;

	for my $dir (split /:/, $ENV{PATH} || "/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin") {
		my $path = "$dir/$cmd";
		return $path if -x $path;
	}

	return $cmd;
}

sub sandbox_parent {
	my $loaded = eval {
		require OpenBSD::Pledge;
		OpenBSD::Pledge->import(qw(pledge));
		require OpenBSD::Unveil;
		OpenBSD::Unveil->import(qw(unveil));
		1;
	};
	if (!$loaded) {
		chomp(my $err = $@ || "unknown error");
		die "maped: pledge/unveil unavailable on OpenBSD: $err\n"
		    if $^O eq "openbsd";
		log_debug("pledge/unveil unavailable; running without sandbox on non-OpenBSD");
		return;
	}

	for my $rule (sandbox_unveil_rules()) {
		my ($path, $perms) = @$rule;
		next if !defined $path || $path eq "" || $path !~ m{^/};
		unveil($path, $perms) or die "maped: unveil $path: $!\n";
	}
	unveil() or die "maped: lock unveil: $!\n";
	pledge(qw(rpath wpath cpath fattr proc exec unix)) or die "maped: pledge: $!\n";
	log_debug("pledge/unveil enabled for parent");
}

sub sandbox_unveil_rules {
	my @rules = (
	    ["/bin/sh", "x"],
	    [$maped_up, "x"],
	    [$maped_down, "x"],
	    [$maped_derive, "x"],
	    [$route, "x"],
	    [$ifconfig, "x"],
	    [$pfctl, "x"],
	    [$dhcp6leasectl, "x"],
	    [$state_dir, "rwc"],
	);

	push @rules, [$conf, "r"] if $conf =~ m{^/};
	push @rules, [dirname($conf{LEASE_FILE}), "r"]
	    if $conf{LEASE_FILE} && $conf{LEASE_FILE} =~ m{^/};

	return @rules;
}

sub dirname {
	my ($path) = @_;
	$path =~ s{/+[^/]*$}{};
	return $path ne "" ? $path : "/";
}

sub atomic_write {
	my ($path, $text) = @_;
	my ($fh, $tmp) = tempfile("state.XXXXXXXX", DIR => $state_dir);
	print {$fh} $text or die "maped: write $tmp: $!";
	close $fh or die "maped: close $tmp: $!";
	rename $tmp, $path or die "maped: rename $path: $!";
}

sub publish_status {
	my $ok = eval {
		$reporter->publish(status => $report_status, reason => $report_reason,
		    plan => $report_plan, confirmed => $confirmed_at, expires => $expires_at,
		    lease_interface => $conf{LEASE_IF} || $conf{WAN_IF},
		    tunnel_interface => $conf{GIF_IF});
		1;
	};
	log_warn("cannot publish status: $@") unless $ok;
	return $ok;
}

sub report_active {
	my ($plan) = @_;
	$report_plan = {%$plan};
	$last_active_plan = {%$plan};
	($report_status, $report_reason) = ('active', undef);
}

sub withdraw {
	my ($reason) = @_;
	$lease_deadline = undef;
	$expires_at = undef;
	$report_plan = undef;
	$last_active_plan = undef;
	($report_status, $report_reason) = ('inactive', $reason);
	publish_status();
	return 1 unless -e $applied_file;
	log_info("withdrawing MAP-E: $reason");
	my ($rc, $out) = command(30, 1024 * 1024, $maped_down, $applied_file);
	if ($rc) {
		($report_status, $report_reason) = ('error', "withdrawal failed: $reason");
		publish_status();
		log_warn("withdrawal failed: " . status_text($rc) . ": $out");
		return 0;
	}
	unlink $state_file if -e $state_file;
	unlink $applied_file or die "maped: remove ownership record: $!";
	return 1;
}

sub cycle {
	($report_status, $report_reason) = ('error', 'configuration or health check failed');
	$report_plan = undef;
	my $result = eval { run_once() };
	if (my $err = $@) {
		($report_status, $report_reason) = ('error', 'reconciliation aborted');
		$report_plan = undef;
		publish_status();
		die $err;
	}
	if (defined $lease_deadline && clock_gettime(CLOCK_MONOTONIC) >= $lease_deadline) {
		withdraw('confirmed lease expired');
		return 0;
	}
	$last_active_plan = undef if $report_status ne 'active' && $report_status ne 'degraded';
	my $published = publish_status();
	return $result && $published;
}

sub run_once {
	if (defined $lease_deadline && clock_gettime(CLOCK_MONOTONIC) >= $lease_deadline) {
		return 0 unless withdraw('confirmed lease expired');
	}
	my $started = clock_gettime(CLOCK_MONOTONIC);
	my ($kind, $seconds, $lease);
	my $ok = eval {
		my $iface = $conf{LEASE_IF} || $conf{WAN_IF} || die "LEASE_IF is required\n";
		my ($rc, $out) = run_command($dhcp6leasectl, '-l', '-m', $iface);
		die "control query failed: " . status_text($rc) . ": $out" if $rc;
		($kind, $seconds, $lease) = live_lease($out, $iface);
		1;
	};
	if (!$ok) {
		($report_status, $report_reason) = ('degraded', 'live lease query failed');
		$report_plan = $last_active_plan;
		log_warn("cannot establish current provisioning: $@");
		# A read failure cannot renew authorization. After restart there is
		# no in-memory proof of validity, so retire our recorded state.
		withdraw('no remaining confirmed lease') if !defined $lease_deadline ||
		    clock_gettime(CLOCK_MONOTONIC) >= $lease_deadline;
		return 0;
	}
	return withdraw('DHCP withdrew the service') if $kind eq 'withdrawn';
	$lease_deadline = $started + $seconds;
	$confirmed_at = time;
	$expires_at = time + ($lease_deadline - clock_gettime(CLOCK_MONOTONIC));
	return withdraw('lease expired during query') if clock_gettime(CLOCK_MONOTONIC) >= $lease_deadline;
	my $snapshot = lease_text($lease);
	my ($fh, $path) = tempfile("lease.XXXXXXXX", DIR => $state_dir);
	print {$fh} $snapshot or die "maped: snapshot write: $!";
	close $fh or die "maped: snapshot close: $!";
	my ($rc, $out);
	{
		local %ENV = (%ENV, %conf, MAPED_SNAPSHOT => $path);
		($rc, $out) = run_command($maped_derive);
	}
	if ($rc) {
		unlink $path;
		log_warn("derivation failed: " . status_text($rc) . ": $out");
		withdraw('new provisioning cannot be applied');
		return 0;
	}
	my %derived = eval { parse_config($out) };
	if ($@ || !defined $derived{CE_IPV6} || !defined $derived{MAPE_IPV4}) {
		unlink $path;
		log_warn('invalid derivation output');
		return 0;
	}
	my %plan = (%conf, %derived);
	my %previous = -e $applied_file ? read_conf($applied_file) : ();
	# Retire old ownership before changing a prefix, BR, or interface.
	if (%previous && grep { ($previous{$_} // '') ne ($plan{$_} // '') }
	    qw(CE_IPV6 BR_IPV6 MAPE_IPV4 WAN_IF GIF_IF PSID_OFFSET PSID_LEN PSID)) {
		if (!withdraw('provisioning changed')) { unlink $path; return 0; }
		$lease_deadline = $started + $seconds;
		$expires_at = time + ($lease_deadline - clock_gettime(CLOCK_MONOTONIC));
		%previous = ();
	}
	my ($wan_rc, $wan) = run_command($ifconfig, $conf{WAN_IF});
	if ($wan_rc) { unlink $path; log_warn("cannot inspect WAN: $wan"); return 0; }
	$plan{MAPED_ALIAS_OWNED} = ($previous{MAPED_ALIAS_OWNED} ||
	    !has_ipv6($wan, $plan{CE_IPV6})) ? 1 : 0;
	$plan{GIF_MTU} = eval { effective_mtu($conf{GIF_MTU}, $wan) };
	if ($@) { unlink $path; log_warn($@); return 0; }
	my $runtime_reason = runtime_reconfigure_reason(\%plan, $wan);
	if (defined $runtime_reason && $runtime_reason =~ /^cannot /) {
		unlink $path;
		log_warn("runtime health check failed: $runtime_reason");
		return 0;
	}
	my $old = read_state();
	my $desired = config_text(\%plan) . $snapshot;
	if (defined $old && $old eq $desired && !defined $runtime_reason && %previous) {
		unlink $path;
		report_active(\%plan);
		return 1;
	}
	my $apply_reason = $runtime_reason // (!%previous ? 'no recorded ownership' :
	    !defined $old ? 'no saved desired state' : 'desired configuration changed');
	log_info("applying current MAP-E provisioning: $apply_reason");
	# Do not advertise the previous runtime while an apply is in progress.
	($report_status, $report_reason) = ('applying', $apply_reason);
	$report_plan = undef;
	publish_status();
	# Record ownership before mutations, so partial failures can be retired.
	atomic_write($applied_file, config_text(\%plan));
	my $budget = $lease_deadline - clock_gettime(CLOCK_MONOTONIC);
	if ($budget <= 0) { unlink $path; return withdraw('lease expired before apply'); }
	($rc, $out) = command($budget < 30 ? $budget : 30, 1024 * 1024,
	    $maped_up, $applied_file, $path);
	unlink $path;
	if ($rc || clock_gettime(CLOCK_MONOTONIC) >= $lease_deadline) {
		log_warn("reconfiguration failed: " . status_text($rc) . ": $out");
		withdraw('failed or expired apply');
		return 0;
	}
	atomic_write($state_file, $desired);
	report_active(\%plan);
	log_info('MAP-E reconfiguration complete');
	return 1;
}

sub runtime_reconfigure_reason {
	my ($plan, $wan) = @_;
	my $gif = $plan->{GIF_IF} || "";
	return "cannot configure without GIF_IF" if $gif eq "";
	my ($if_rc, $ifconfig_out) = run_command($ifconfig, $gif);
	return "cannot run $ifconfig $gif: $ifconfig_out" if $if_rc == -1;
	return "$gif does not exist" if $if_rc != 0;
	my ($pf_rc, $rules) = run_command($pfctl, "-a", "mape", "-sr");
	return "cannot read PF anchor: $rules" if $pf_rc != 0;
	my ($route_rc, $routing) = run_command($route, '-n', 'get', '-inet', 'default');
	return "cannot run route: $routing" if $route_rc == -1;
	$routing = '' if $route_rc;
	return runtime_mismatch($plan, $ifconfig_out, $wan, $rules, $routing);
}

sub load_kqueue {
	my $ok = eval {
		require IO::KQueue;
		IO::KQueue->import(qw(
		    EVFILT_VNODE EV_ADD EV_ENABLE EV_CLEAR
		    NOTE_WRITE NOTE_DELETE NOTE_EXTEND NOTE_ATTRIB NOTE_RENAME NOTE_REVOKE
		));
		1;
	} ? 1 : 0;
	log_debug($ok ? "IO::KQueue loaded" : "IO::KQueue unavailable; polling fallback enabled");
	return $ok;
}

sub wait_for_change {
	my $wait = $interval;
	if (defined $lease_deadline) {
		my $left = int($lease_deadline - clock_gettime(CLOCK_MONOTONIC));
		$wait = $left if $left < $wait;
		$wait = 1 if $wait < 1;
	}
	if ($have_kqueue && $conf{LEASE_FILE} && -r $conf{LEASE_FILE}) {
		if (wait_for_kqueue_change($conf{LEASE_FILE}, $wait)) {
			log_debug("kqueue reported lease file event");
			return;
		}
		log_warn("kqueue watch unavailable; falling back to polling");
	}

	log_debug("polling sleep for ${interval}s");
	sleep $wait;
}

sub wait_for_kqueue_change {
	my ($path, $wait) = @_;
	open my $fh, "<", $path or return 0;

	my $kq = eval { IO::KQueue->new() };
	if (!$kq) {
		close $fh;
		return 0;
	}

	my $flags = &EV_ADD | &EV_ENABLE | &EV_CLEAR;
	my $notes = &NOTE_WRITE | &NOTE_DELETE | &NOTE_EXTEND | &NOTE_ATTRIB | &NOTE_RENAME | &NOTE_REVOKE;
	my $ok = eval {
		$kq->EV_SET(fileno($fh), &EVFILT_VNODE, $flags, $notes, 0, 0);
		$kq->kevent($wait * 1000);
		1;
	} ? 1 : 0;
	POSIX::close($$kq);
	close $fh;

	return $ok;
}

sub read_file {
	my ($path) = @_;
	open my $fh, "<", $path or return "";
	local $/;
	return <$fh>;
}

sub read_cmd {
	my ($rc, $out) = run_command(@_);
	return $rc == 0 ? $out : "";
}

sub run_command {
	my $budget = 30;
	if (defined $lease_deadline) {
		my $left = $lease_deadline - clock_gettime(CLOCK_MONOTONIC);
		return (-1, 'confirmed lease expired') if $left <= 0;
		$budget = $left if $left < $budget;
	}
	return command($budget, 1024 * 1024, @_);
}

sub read_state {
	return undef unless -r $state_file;
	return read_file($state_file);
}

sub log_debug {
	my ($msg) = @_;
	log_msg("debug", LOG_DEBUG, $msg);
}

sub log_info {
	my ($msg) = @_;
	log_msg("info", LOG_INFO, $msg);
}

sub log_warn {
	my ($msg) = @_;
	log_msg("warn", LOG_WARNING, $msg);
}

sub log_msg {
	my ($level, $prio, $msg) = @_;
	return if $log_rank{$level} < $log_rank{$log_level};
	syslog($prio, "%s", $msg);
	print strftime("%Y-%m-%d %H:%M:%S", localtime) . " [$level] $msg\n"
	    unless $daemon;
}
