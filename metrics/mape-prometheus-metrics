#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
#
# Emit Prometheus textfile metrics for an OpenBSD MAP-E CE router.
#
# This script intentionally performs the privileged collection as a short-lived
# root process and writes a static textfile for a non-root exporter to serve.

set -eu

PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

CONF="/etc/maped.conf"
OUT="/var/prometheus/textfile/mape.prom"
WAN_IF="pppoe0"
LEASE_IF=""
GIF_IF="gif0"
PF_ANCHOR="mape"
CLI_WAN_IF=""
CLI_GIF_IF=""

usage() {
	cat <<EOF
usage: mape-prometheus-metrics [options]

options:
  -c file        maped config file (default: /etc/maped.conf)
  -o file        output metrics file (default: /var/prometheus/textfile/mape.prom)
  -w interface   WAN interface fallback (default: pppoe0)
  -g interface   gif interface fallback (default: gif0)
  -a anchor      PF anchor name (default: mape)
  -h             show this help

The output file is replaced atomically.
EOF
	exit 2
}

need_arg() {
	[ "$#" -ge 2 ] || usage
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	-c)
		need_arg "$@"
		CONF="$2"
		shift 2
		;;
	-o)
		need_arg "$@"
		OUT="$2"
		shift 2
		;;
	-w)
		need_arg "$@"
		CLI_WAN_IF="$2"
		shift 2
		;;
	-g)
		need_arg "$@"
		CLI_GIF_IF="$2"
		shift 2
		;;
	-a)
		need_arg "$@"
		PF_ANCHOR="$2"
		shift 2
		;;
	-h|--help)
		usage
		;;
	*)
		usage
		;;
	esac
done

if [ -r "$CONF" ]; then
	# shellcheck disable=SC1090
	. "$CONF"
fi

WAN_IF="${WAN_IF:-pppoe0}"
LEASE_IF="${LEASE_IF:-$WAN_IF}"
GIF_IF="${GIF_IF:-gif0}"
[ "$CLI_WAN_IF" = "" ] || WAN_IF="$CLI_WAN_IF"
[ "$CLI_GIF_IF" = "" ] || GIF_IF="$CLI_GIF_IF"
PF_ANCHOR_FILE="${PF_ANCHOR_FILE:-/etc/pf.anchors/$PF_ANCHOR}"
MAPED_DERIVE="${MAPED_DERIVE:-${DERIVE_COMMAND:-/usr/local/libexec/maped/maped-derive}}"
LEASE_FILE="${LEASE_FILE:-/var/db/dhcp6leased/$LEASE_IF}"
PFCTL="${PFCTL:-pfctl}"
IFCONFIG="${IFCONFIG:-ifconfig}"
DHCP6LEASECTL="${DHCP6LEASECTL:-dhcp6leasectl}"
NETSTAT="${NETSTAT:-netstat}"
RCCTL="${RCCTL:-rcctl}"

export WAN_IF LEASE_IF GIF_IF LEASE_FILE PF_ANCHOR_FILE MAPED_DERIVE
export PD_PREFIX PD_IF DHCP6LEASECTL
export MAP_IPV6_PREFIX MAP_IPV6_PLEN MAP_IPV4_PREFIX MAP_IPV4_PLEN EA_LEN PSID_OFFSET BR_IPV6

OUT_DIR="$(dirname "$OUT")"
TMP="$OUT.$$"
mkdir -p "$OUT_DIR"
trap 'rm -f "$TMP" "$TMP".pfctl_*' EXIT

collect() {
	# Preserve the exit status instead of treating a failed command as empty data.
	COLLECTED=""
	if COLLECTED=$("$@" 2>/dev/null); then
		COLLECT_OK=1
	else
		COLLECT_OK=0
	fi
}

collect_file() {
	file=$1
	shift
	if "$@" >"$file" 2>/dev/null; then
		COLLECT_OK=1
	else
		COLLECT_OK=0
		: >"$file"
	fi
}

# maped-derive emits quoted shell assignments; read values without evaluating them.
derived_value() {
	printf '%s\n' "$DERIVE" | awk -v key="$1" '
	    index($0, key "=\047") == 1 && substr($0, length($0)) == "\047" {
	        print substr($0, length(key) + 3, length($0) - length(key) - 3)
	        exit
	    }
	'
}

config_matches_lease() {
	[ "$DERIVE_OK" -eq 1 ] && [ "$PF_ANCHOR_OK" -eq 1 ] &&
	    [ "$GIF_OK" -eq 1 ] && [ "$WAN_OK" -eq 1 ] &&
	    [ "$ROUTES_OK" -eq 1 ] || return 1
	ce=$(derived_value CE_IPV6)
	br=$(derived_value BR_IPV6)
	ipv4=$(derived_value MAPE_IPV4)
	offset=$(derived_value PSID_OFFSET)
	length=$(derived_value PSID_LEN)
	psid=$(derived_value PSID)
	[ -n "$ce" ] && [ -n "$br" ] && [ -n "$ipv4" ] &&
	    [ -n "$offset" ] && [ -n "$length" ] && [ -n "$psid" ] || return 1
	perl -MSocket=AF_INET6,inet_pton - "$ce" "$br" "$ipv4" \
	    "$offset/$length/$psid" "$GIF_IF" "$IF_GIF" "$IF_WAN" \
	    "$PF_MMAPE" "$ROUTES" "${MAPED_PEER_IPV4:-0.0.0.1}" <<'PERL'
use strict;
use warnings;
my ($ce, $br, $ipv4, $portset, $gif, $gif_text, $wan_text, $rules, $routes, $peer) = @ARGV;
sub same_ipv6 {
	my ($a, $b) = @_;
	my $packed_a = inet_pton(AF_INET6, $a // "");
	my $packed_b = inet_pton(AF_INET6, $b // "");
	return defined($packed_a) && defined($packed_b) && $packed_a eq $packed_b;
}
my ($tunnel_ce, $tunnel_br) = $gif_text =~ /\btunnel: inet6 ([0-9a-fA-F:]+) --> ([0-9a-fA-F:]+)/;
exit 1 unless same_ipv6($ce, $tunnel_ce) && same_ipv6($br, $tunnel_br);
exit 1 unless $gif_text =~ /\binet \Q$ipv4\E --> \Q$peer\E(?:\s|$)/;
my @aliases = $wan_text =~ /\binet6 ([0-9a-fA-F:]+)/g;
exit 1 unless grep { same_ipv6($ce, $_) } @aliases;
my @nat = grep { /\bmap-e-portset\b/ } split /\n/, $rules;
exit 1 unless @nat;
for my $rule (@nat) {
	exit 1 unless $rule =~ /\bon \Q$gif\E\s/ &&
	    $rule =~ /\bnat-to \(\Q$gif\E\)/ &&
	    $rule =~ /\bmap-e-portset \Q$portset\E(?:\s|$)/;
}
exit 1 unless $routes =~ /^default\s+\S+\s+.*\s\Q$gif\E\s*$/m;
PERL
}

bool_grep() {
	text="$1"
	pattern="$2"
	if printf '%s\n' "$text" | grep -q "$pattern"; then
		printf '1'
	else
		printf '0'
	fi
}

emit_help_type() {
	name="$1"
	help="$2"
	type="$3"
	printf '# HELP %s %s\n' "$name" "$help"
	printf '# TYPE %s %s\n' "$name" "$type"
}

emit_gauge() {
	name="$1"
	value="$2"
	printf '%s %s\n' "$name" "$value"
}

emit_labeled_gauge() {
	name="$1"
	label="$2"
	value="$3"
	printf '%s{%s} %s\n' "$name" "$label" "$value"
}

emit_pfctl_exporter_metrics() {
	perl -MTime::Local=timelocal - "$PFCTL_INFO_VERBOSE" "$PFCTL_INTERFACES_VERBOSE" "$PFCTL_RULES_VERBOSE" "$PFCTL_TABLES_VERBOSE" <<'PERL'
use strict;
use warnings;

my ($info_file, $interfaces_file, $rules_file, $tables_file) = @ARGV;
my %declared;

sub read_lines {
	my ($file) = @_;
	open my $fh, "<", $file or return ();
	chomp(my @lines = <$fh>);
	close $fh;
	return @lines;
}

sub label_escape {
	my ($value) = @_;
	$value =~ s/\\/\\\\/g;
	$value =~ s/"/\\"/g;
	$value =~ s/\n/\\n/g;
	return $value;
}

sub labelset {
	my (@pairs) = @_;
	my @labels;
	while (@pairs) {
		my $key = shift @pairs;
		my $value = shift @pairs;
		push @labels, $key . '="' . label_escape($value) . '"';
	}
	return @labels ? "{" . join(",", @labels) . "}" : "";
}

sub counter_name {
	my ($name) = @_;
	return $name =~ /_total\z/ ? $name : "${name}_total";
}

sub declare_metric {
	my ($name, $type, $help) = @_;
	return if $declared{$name}++;
	print "# HELP $name $help\n";
	print "# TYPE $name $type\n";
}

sub emit_sample {
	my ($name, $type, $value, $help, @labels) = @_;
	$name = counter_name($name) if $type eq "counter";
	declare_metric($name, $type, $help);
	print $name . labelset(@labels) . " $value\n";
}

sub parse_timestamp {
	my ($text) = @_;
	my %month = (
		Jan => 0, Feb => 1, Mar => 2, Apr => 3, May => 4, Jun => 5,
		Jul => 6, Aug => 7, Sep => 8, Oct => 9, Nov => 10, Dec => 11,
	);
	return 0 unless $text =~ /^\S+ (\S+) +(\d+) (\d+):(\d+):(\d+) (\d+)$/;
	my ($mon, $mday, $hour, $min, $sec, $year) = ($1, $2, $3, $4, $5, $6);
	return 0 unless exists $month{$mon};
	my $epoch = eval { timelocal($sec, $min, $hour, $mday, $month{$mon}, $year) };
	return defined $epoch ? $epoch : 0;
}

sub collect_info {
	my ($file) = @_;
	my $header = "";
	for my $line (read_lines($file)) {
		next if $line eq "";
		next if $header eq "" && substr($line, 0, 11) ne "State Table";
		if (substr($line, 0, 2) ne "  ") {
			if (index($line, "Total             Rate") >= 0) {
				$line = substr($line, 0, index($line, "  "));
			}
			$line =~ s/^\s+|\s+\z//g;
			$header = lc $line;
			$header =~ s/ /_/g;
			next;
		}
		if ($line =~ /^  ([a-z\- ]+?) +([0-9]+).*/) {
			my ($key, $value) = ($1, $2);
			$key =~ s/[ -]/_/g;
			my $name = "pfctl_${header}_${key}";
			my $type = $line =~ /\/s\z/ ? "counter" : "gauge";
			emit_sample($name, $type, $value, $name);
			next;
		}
		if ($header eq "syncookies" && $line =~ /^  mode\s+(.+)$/) {
			emit_sample(
				"pfctl_syncookies_mode",
				"gauge",
				1,
				"The current syncookies mode is in the 'mode' label of this metric. The value of this metric is always 1.",
				"mode", $1
			);
			next;
		}
		if ($header eq "syncookies" && $line =~ /^  active\s+(.+)$/) {
			emit_sample(
				"pfctl_syncookies_active",
				"gauge",
				1,
				"The current syncookies active status is in the 'active' label of this metric. The value of this metric is always 1.",
				"active", $1
			);
			next;
		}
	}
}

sub collect_interfaces {
	my ($file) = @_;
	my $interface = "";
	for my $line (read_lines($file)) {
		next if $line eq "";
		if ($line =~ /^([a-z0-9.]+)( \(skip\))?$/) {
			$interface = $1;
			emit_sample(
				"pfctl_interface_skip",
				"gauge",
				defined($2) ? 1 : 0,
				"This Gauge is 1 if filtering on the interface is disabled with 'set skip' or 0 if filtering is enabled on the interface",
				"interface", $interface
			);
			next;
		}
		if ($line =~ /^\tReferences:\s+(\d+)\s*/) {
			emit_sample(
				"pfctl_interface_ruleset_references",
				"gauge",
				$1,
				"The number of rules in the current pf ruleset referencing this interface",
				"interface", $interface
			);
			next;
		}
		if ($line =~ /^\tCleared:\s+(.+)/) {
			emit_sample(
				"pfctl_interface_cleared_timestamp_seconds",
				"gauge",
				parse_timestamp($1),
				"Timestamp for when the counters for this interface were last reset",
				"interface", $interface
			);
			next;
		}
		if ($line =~ /^\t(In|Out)(4|6)\/(Block|Pass): +\[ +Packets: +([0-9]+) +Bytes: +([0-9]+) +\]/) {
			my ($direction, $family, $action, $packets, $bytes) =
			    ($1, "ipv$2", $3, $4, $5);
			emit_sample(
				"pfctl_interface_packets_total",
				"counter",
				$packets,
				"The number of packets on this interface aggregated by direction, family, and action",
				"interface", $interface, "direction", $direction, "family", $family, "action", $action
			);
			emit_sample(
				"pfctl_interface_bytes_total",
				"counter",
				$bytes,
				"The number of bytes on this interface aggregated by direction, family, and action",
				"interface", $interface, "direction", $direction, "family", $family, "action", $action
			);
			next;
		}
	}
}

sub collect_rules {
	my ($file) = @_;
	my $rule = "";
	for my $line (read_lines($file)) {
		next if $line eq "";
		if ($line =~ /^([a-z]+.*)$/) {
			$rule = $1;
			next;
		}
		if ($line =~ /^  \[ Evaluations: ([0-9]+)\s+Packets: ([0-9]+)\s+Bytes: ([0-9]+)\s+States: ([0-9]+)\s+\]$/) {
			my %value = (
				evaluations => $1,
				packets => $2,
				bytes => $3,
				states => $4,
			);
			for my $metric (qw(evaluations packets bytes states)) {
				emit_sample(
					"pfctl_rule_${metric}_total",
					"counter",
					$value{$metric},
					"Total number of {metric} for this pf rule",
					"rule", $rule
				);
			}
		}
	}
}

sub collect_tables {
	my ($file) = @_;
	my $table = "";
	my @flags = qw(constant persistent active inactive referenced hidden counters);
	for my $line (read_lines($file)) {
		next if $line eq "";
		if ($line =~ /^([c-])([p-])([a-])([i-])([r-])([h-])([C-])\t([a-z0-9-_]+)$/) {
			$table = $8;
			my @values = ($1, $2, $3, $4, $5, $6, $7);
			for my $idx (0 .. $#flags) {
				my $flag = $flags[$idx];
				emit_sample(
					"pfctl_table_flags_$flag",
					"gauge",
					$values[$idx] eq "-" ? 0 : 1,
					"Gauge set to 1 if this pf table has the $flag flag, 0 if not.",
					"table", $table
				);
			}
			next;
		}
		if ($line =~ /^\tAddresses:\s+([0-9]+)/) {
			emit_sample(
				"pfctl_table_addresses",
				"gauge",
				$1,
				"Total number of addresses in this pf table",
				"table", $table
			);
			next;
		}
		if ($line =~ /^\tCleared:\s+(.+)/) {
			emit_sample(
				"pfctl_table_cleared_timestamp_seconds",
				"gauge",
				parse_timestamp($1),
				"Timestamp for when the counters for this table were last reset",
				"table", $table
			);
			next;
		}
		if ($line =~ /^\tReferences:\s+\[ Anchors: ([0-9]+)\s+Rules: ([0-9]+)\s+\]$/) {
			emit_sample(
				"pfctl_table_anchor_references",
				"gauge",
				$1,
				"The number of anchors in the current pf ruleset referencing this table",
				"table", $table
			);
			emit_sample(
				"pfctl_table_ruleset_references",
				"gauge",
				$2,
				"The number of rules in the current pf ruleset referencing this table",
				"table", $table
			);
			next;
		}
		if ($line =~ /^\tEvaluations:\s+\[ NoMatch: ([0-9]+)\s+Match: ([0-9]+)\s+\]$/) {
			emit_sample(
				"pfctl_table_nomatch_evaluations",
				"counter",
				$1,
				"The number of evaluations of this pf table resulting in a no-match",
				"table", $table
			);
			emit_sample(
				"pfctl_table_match_evaluations",
				"counter",
				$2,
				"The number of evaluations of this pf table resulting in a match",
				"table", $table
			);
			next;
		}
		if ($line =~ /^\t(In|Out)\/(Block|Pass|XPass):\s+\[ Packets: ([0-9]+)\s+Bytes: ([0-9]+)\s+\]/) {
			my ($direction, $action, $packets, $bytes) = ($1, $2, $3, $4);
			emit_sample(
				"pfctl_table_packets_total",
				"counter",
				$packets,
				"The number of packets for this table aggregated by traffic direction and firewall action",
				"table", $table, "direction", $direction, "action", $action
			);
			emit_sample(
				"pfctl_table_bytes_total",
				"counter",
				$bytes,
				"The number of bytes for this table aggregated by traffic direction and firewall action",
				"table", $table, "direction", $direction, "action", $action
			);
			next;
		}
	}
}

collect_info($info_file);
collect_interfaces($interfaces_file);
collect_rules($rules_file);
collect_tables($tables_file);
PERL
}

PFCTL_INFO_VERBOSE="$TMP.pfctl_info"
PFCTL_INTERFACES_VERBOSE="$TMP.pfctl_interfaces"
PFCTL_RULES_VERBOSE="$TMP.pfctl_rules"
PFCTL_TABLES_VERBOSE="$TMP.pfctl_tables"

collect "$PFCTL" -sq -v; PF_QUEUES="$COLLECTED"; PF_QUEUES_OK="$COLLECT_OK"
collect "$PFCTL" -a "$PF_ANCHOR" -sr; PF_MMAPE="$COLLECTED"; PF_ANCHOR_OK="$COLLECT_OK"
collect_file "$PFCTL_INFO_VERBOSE" "$PFCTL" -vvs info; PF_INFO_OK="$COLLECT_OK"
collect_file "$PFCTL_INTERFACES_VERBOSE" "$PFCTL" -vvs Interfaces; PF_INTERFACES_OK="$COLLECT_OK"
collect_file "$PFCTL_RULES_VERBOSE" "$PFCTL" -Pvs rules; PF_RULES_OK="$COLLECT_OK"
collect_file "$PFCTL_TABLES_VERBOSE" "$PFCTL" -vvs Tables; PF_TABLES_OK="$COLLECT_OK"
collect "$IFCONFIG" "$GIF_IF"; IF_GIF="$COLLECTED"; GIF_OK="$COLLECT_OK"
collect "$IFCONFIG" "$WAN_IF"; IF_WAN="$COLLECTED"; WAN_OK="$COLLECT_OK"
collect "$DHCP6LEASECTL" -l "$LEASE_IF"; LEASE="$COLLECTED"; LEASE_OK="$COLLECT_OK"
collect "$NETSTAT" -rn; ROUTES="$COLLECTED"; ROUTES_OK="$COLLECT_OK"
collect "$MAPED_DERIVE"; DERIVE="$COLLECTED"; DERIVE_OK="$COLLECT_OK"
ANCHOR_FILE_CONTENT=""
[ -r "$PF_ANCHOR_FILE" ] && ANCHOR_FILE_CONTENT="$(cat "$PF_ANCHOR_FILE")"

{
	printf '# Generated by mape-prometheus-metrics at %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

	emit_help_type mape_collection_success "Whether a collector data source command completed successfully." gauge
	for source in pf_queues pf_anchor pf_info pf_interfaces pf_rules pf_tables gif wan lease routes derive; do
		case "$source" in
		pf_queues) result=$PF_QUEUES_OK ;; pf_anchor) result=$PF_ANCHOR_OK ;;
		pf_info) result=$PF_INFO_OK ;; pf_interfaces) result=$PF_INTERFACES_OK ;;
		pf_rules) result=$PF_RULES_OK ;; pf_tables) result=$PF_TABLES_OK ;;
		gif) result=$GIF_OK ;; wan) result=$WAN_OK ;;
		lease) result=$LEASE_OK ;; routes) result=$ROUTES_OK ;;
		derive) result=$DERIVE_OK ;;
		esac
		emit_labeled_gauge mape_collection_success "source=\"$source\"" "$result"
	done

	emit_help_type maped_up "Whether rcctl reports maped as running." gauge
	if "$RCCTL" check maped >/dev/null 2>&1; then
		emit_gauge maped_up 1
	else
		emit_gauge maped_up 0
	fi

	emit_help_type dhcp6leased_up "Whether rcctl reports dhcp6leased as running." gauge
	if "$RCCTL" check dhcp6leased >/dev/null 2>&1; then
		emit_gauge dhcp6leased_up 1
	else
		emit_gauge dhcp6leased_up 0
	fi

	emit_help_type dhcp6leased_mape_bound "Whether dhcp6leasectl reports MAP-E lease data for the lease interface." gauge
	emit_gauge dhcp6leased_mape_bound "$(bool_grep "$LEASE" 'MAP-E')"

	emit_help_type mape_gif_up "Whether the MAP-E gif interface has the UP flag." gauge
	emit_gauge mape_gif_up "$(bool_grep "$IF_GIF" 'flags=.*UP')"

	emit_help_type mape_gif_running "Whether the MAP-E gif interface has the RUNNING flag." gauge
	emit_gauge mape_gif_running "$(bool_grep "$IF_GIF" 'flags=.*RUNNING')"

	emit_help_type pppoe_session_up "Whether the PPPoE interface reports active status." gauge
	emit_gauge pppoe_session_up "$(bool_grep "$IF_WAN" 'status: active')"

	emit_help_type mape_anchor_portset_present "Whether the live PF MAP-E anchor contains a map-e-portset rule." gauge
	emit_gauge mape_anchor_portset_present "$(bool_grep "$PF_MMAPE" 'map-e-portset')"

	emit_help_type mape_anchor_file_portset_present "Whether the generated PF anchor file contains a map-e-portset rule." gauge
	emit_gauge mape_anchor_file_portset_present "$(bool_grep "$ANCHOR_FILE_CONTENT" 'map-e-portset')"

	emit_help_type mape_default_route_v4 "Whether the IPv4 default route points at the MAP-E gif interface." gauge
	if printf '%s\n' "$ROUTES" | awk -v gif="$GIF_IF" '$1 == "default" && $NF == gif { found = 1 } END { exit found ? 0 : 1 }'; then
		emit_gauge mape_default_route_v4 1
	else
		emit_gauge mape_default_route_v4 0
	fi

	emit_help_type mape_default_route_v6 "Whether the IPv6 default route points at the WAN interface." gauge
	if printf '%s\n' "$ROUTES" | awk -v wan="$WAN_IF" '$1 == "default" && $NF == wan { found = 1 } END { exit found ? 0 : 1 }'; then
		emit_gauge mape_default_route_v6 1
	else
		emit_gauge mape_default_route_v6 0
	fi

	emit_help_type mape_derive_ok "Whether maped-derive completed and produced CE IPv6 and MAP-E IPv4 values." gauge
	if [ "$DERIVE_OK" -eq 1 ] && [ -n "$(derived_value CE_IPV6)" ] && [ -n "$(derived_value MAPE_IPV4)" ]; then
		emit_gauge mape_derive_ok 1
	else
		emit_gauge mape_derive_ok 0
	fi

	emit_help_type mape_config_matches_lease "Whether the live tunnel, CE alias, PF NAT port set and IPv4 route match the derived lease." gauge
	if config_matches_lease; then
		emit_gauge mape_config_matches_lease 1
	else
		emit_gauge mape_config_matches_lease 0
	fi

	emit_pfctl_exporter_metrics

	emit_help_type pf_queue_packets_total "Cumulative packets handled by the PF queue." counter
	emit_help_type pf_queue_bytes_total "Cumulative bytes handled by the PF queue." counter
	emit_help_type pf_queue_dropped_packets_total "Cumulative packets dropped by the PF queue." counter
	emit_help_type pf_queue_dropped_bytes_total "Cumulative bytes dropped by the PF queue." counter
	emit_help_type pf_queue_length "Current PF queue occupancy." gauge
	emit_help_type pf_queue_limit "Maximum PF queue occupancy." gauge
	if [ "$PF_QUEUES_OK" -eq 1 ]; then
		printf '%s\n' "$PF_QUEUES" | awk '
	    /^queue / {
	        queue = $2
	        next
	    }
	    /pkts:/ && /dropped pkts:/ {
	        if (queue == "") next
	        pkts = $3 + 0
	        bytes = $5 + 0
	        drops = $8 + 0
	        drop_bytes = $10 + 0
	        printf "pf_queue_packets_total{queue=\"%s\"} %s\n", queue, pkts
	        printf "pf_queue_bytes_total{queue=\"%s\"} %s\n", queue, bytes
	        printf "pf_queue_dropped_packets_total{queue=\"%s\"} %s\n", queue, drops
	        printf "pf_queue_dropped_bytes_total{queue=\"%s\"} %s\n", queue, drop_bytes
	        next
	    }
	    /qlength:/ {
	        if (queue == "" || $3 !~ /^[0-9]+\/[0-9]+$/) next
	        split($3, a, "/")
	        printf "pf_queue_length{queue=\"%s\"} %s\n", queue, a[1] + 0
	        printf "pf_queue_limit{queue=\"%s\"} %s\n", queue, a[2] + 0
	        next
	    }
	'
	fi
} >"$TMP"

chmod 0644 "$TMP"
mv "$TMP" "$OUT"
rm -f "$TMP".pfctl_*
trap - EXIT
