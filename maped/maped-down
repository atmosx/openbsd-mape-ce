#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || exec doas "$0" "$@"

CONF="${1:-/etc/maped.conf}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
CONFIG_TEXT=$("$SCRIPT_DIR/maped-config" "$CONF")
eval "$CONFIG_TEXT"

route delete -inet default >/dev/null 2>&1 || true
pfctl -a mape -F rules >/dev/null 2>&1 || true

if ifconfig "$GIF_IF" >/dev/null 2>&1; then
	ifconfig "$GIF_IF" destroy
fi

echo "MAP-E is down"
