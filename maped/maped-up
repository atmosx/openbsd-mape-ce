#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || exec doas "$0" "$@"

CONF="${1:-/etc/maped.conf}"
. "$CONF"

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
DERIVE_COMMAND="${MAPED_DERIVE:-${DERIVE_COMMAND:-/usr/local/libexec/maped/maped-derive}}"
[ -x "$DERIVE_COMMAND" ] || DERIVE_COMMAND="$SCRIPT_DIR/maped-derive"

export PD_PREFIX PD_IF LEASE_FILE LEASE_IF WAN_IF DHCP6LEASECTL
export MAP_IPV6_PREFIX MAP_IPV6_PLEN MAP_IPV4_PREFIX MAP_IPV4_PLEN EA_LEN PSID_OFFSET BR_IPV6

eval "$("$DERIVE_COMMAND")"

echo "Derived MAP-E values:"
echo "  PD_PREFIX=$PD_PREFIX"
echo "  CE_IPV6=$CE_IPV6"
echo "  MAPE_IPV4=$MAPE_IPV4"
echo "  BR_IPV6=$BR_IPV6"
echo "  PSID_OFFSET=$PSID_OFFSET"
echo "  PSID_LEN=$PSID_LEN"
echo "  PSID=$PSID"

if ! ifconfig "$WAN_IF" >/dev/null 2>&1; then
	echo "$WAN_IF does not exist"
	exit 1
fi

if ! ifconfig "$WAN_IF" | grep -q "$CE_IPV6"; then
	ifconfig "$WAN_IF" inet6 alias "$CE_IPV6" prefixlen 128
fi

if ifconfig "$GIF_IF" >/dev/null 2>&1; then
	ifconfig "$GIF_IF" destroy
fi

ifconfig "$GIF_IF" create
ifconfig "$GIF_IF" tunnel "$CE_IPV6" "$BR_IPV6"
ifconfig "$GIF_IF" inet "$MAPE_IPV4" "$MAPE_PEER_IPV4" netmask 255.255.255.255
ifconfig "$GIF_IF" mtu "$GIF_MTU"
ifconfig "$GIF_IF" up

mkdir -p "$(dirname "$PF_ANCHOR_FILE")"
PF_ANCHOR_TMP="$(mktemp "$PF_ANCHOR_FILE.XXXXXXXXXX")"
trap 'rm -f "$PF_ANCHOR_TMP"' EXIT

cat > "$PF_ANCHOR_TMP" <<EOF
match out on $GIF_IF inet from ($GIF_IF) to any nat-to ($GIF_IF) map-e-portset $PSID_OFFSET/$PSID_LEN/$PSID
match out on $GIF_IF inet from $LAN_NET to any nat-to ($GIF_IF) map-e-portset $PSID_OFFSET/$PSID_LEN/$PSID

pass out quick on $WAN_IF inet6 proto 4 from $CE_IPV6 to $BR_IPV6 keep state
pass in  quick on $WAN_IF inet6 proto 4 from $BR_IPV6 to $CE_IPV6 keep state

pass out quick on $GIF_IF inet from ($GIF_IF) to any keep state
pass in  quick on $GIF_IF inet from any to ($GIF_IF) keep state
EOF

pfctl -a mape -nf "$PF_ANCHOR_TMP"
pfctl -a mape -f "$PF_ANCHOR_TMP"
mv "$PF_ANCHOR_TMP" "$PF_ANCHOR_FILE"
trap - EXIT

route delete -inet default >/dev/null 2>&1 || true
route add -inet default -ifp "$GIF_IF" "$MAPE_PEER_IPV4"

echo "MAP-E is up"
ifconfig "$GIF_IF"
route -n show -inet | grep default || true
pfctl -a mape -sr
