#!/usr/bin/perl
#
# Cron-friendly MAP-E CE and IPv6 metrics collector for OpenBSD.
#
# Typical install:
#   install -o root -g wheel -m 750 mape-metrics /usr/local/sbin/mape-metrics
#   crontab -e
#   */5 * * * * /usr/local/sbin/mape-metrics
#
# Output defaults:
#   /var/log/mape-watch/<host>-<timestamp>.metrics
#   /var/log/mape-watch/<host>-<timestamp>.raw
#   /var/log/mape-watch/<host>-<timestamp>.state
#   /var/log/mape-watch/<host>-<timestamp>.diff
#   /var/log/mape-watch/index.tsv

package MapeMetrics;

use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use POSIX qw(strftime);
use File::Path qw(make_path);
use File::Basename qw(dirname);
use FindBin;

our $VERSION = 1;

sub usage {
	return <<"USAGE";
usage: mape-metrics [options]

Options:
  -c, --conf FILE          MAP-E config file (default: /etc/mape.conf)
  -o, --log-dir DIR        directory for metrics/raw logs (default: /var/log/mape-watch)
      --state-dir DIR      directory for last-state lock/diff state (default: /var/db/mape-watch)
      --iface IFACE        interface to collect; may be repeated
      --derive-command CMD command/path for mape-derive
      --tail-lines N       syslog lines to inspect per file (default: 250)
      --stdout             also print metrics to stdout
      --no-raw             skip raw command/log sections
      --help               show this help
USAGE
}

sub now_utc {
	return strftime("%Y%m%dT%H%M%SZ", gmtime);
}

sub now_iso_utc {
	return strftime("%Y-%m-%dT%H:%M:%SZ", gmtime);
}

sub trim {
	my ($s) = @_;
	$s = "" unless defined $s;
	$s =~ s/^\s+//;
	$s =~ s/\s+$//;
	return $s;
}

sub parse_shell_value {
	my ($value) = @_;
	$value = trim($value);

	if ($value =~ /^'([^']*)'\s*(?:#.*)?$/) {
		return $1;
	}

	if ($value =~ /^"((?:\\"|\\\\|[^"])*)"\s*(?:#.*)?$/) {
		my $s = $1;
		$s =~ s/\\(["\\])/$1/g;
		return $s;
	}

	$value =~ s/\s+#.*$//;
	return trim($value);
}

sub parse_conf_text {
	my ($text) = @_;
	my %conf;

	for my $line (split /\n/, $text) {
		$line =~ s/\r$//;
		$line =~ s/^\s*export\s+//;
		next if $line =~ /^\s*(?:#|$)/;
		next unless $line =~ /^\s*([A-Za-z_][A-Za-z0-9_]*)=(.*)$/;
		$conf{$1} = parse_shell_value($2);
	}

	return %conf;
}

sub parse_conf_file {
	my ($path) = @_;
	open my $fh, "<", $path or die "mape-metrics: cannot read $path: $!\n";
	local $/;
	my $text = <$fh>;
	close $fh;
	return parse_conf_text($text);
}

sub sanitize {
	my ($s) = @_;
	$s = "" unless defined $s;
	$s =~ s/(authkey|password|passwd|secret|psk)\s+\S+/$1 REDACTED/ig;
	$s =~ s/(authkey=|password=|passwd=|secret=|psk=)\S+/$1REDACTED/ig;
	$s =~ s/(authname\s+")([^"]+)(")/$1REDACTED$3/ig;
	return $s;
}

sub escape_value {
	my ($s) = @_;
	$s = "" unless defined $s;
	$s =~ s/\\/\\\\/g;
	$s =~ s/\t/\\t/g;
	$s =~ s/\n/\\n/g;
	return $s;
}

sub unescape_value {
	my ($s) = @_;
	$s = "" unless defined $s;
	$s =~ s/\\n/\n/g;
	$s =~ s/\\t/\t/g;
	$s =~ s/\\\\/\\/g;
	return $s;
}

sub metric {
	my ($ctx, $name, $value) = @_;
	$value = "" unless defined $value;
	push @{$ctx->{metrics}}, [$name, "$value"];
}

sub raw_section {
	my ($ctx, $title, $rc, $body) = @_;
	return unless $ctx->{raw_enabled};
	$body = sanitize($body);
	push @{$ctx->{raw}}, [$title, $rc, $body];
}

sub read_text_file {
	my ($path, $line_limit) = @_;
	return (1, "not readable\n") unless defined $path && -r $path;

	open my $fh, "<", $path or return (1, "cannot read $path: $!\n");
	my $out = "";
	my $line_no = 0;
	while (my $line = <$fh>) {
		++$line_no;
		last if defined $line_limit && $line_no > $line_limit;
		$out .= $line;
	}
	close $fh;
	return (0, $out);
}

sub run_cmd {
	my ($env, @cmd) = @_;
	my $pid = open my $fh, "-|";
	if (!defined $pid) {
		return (127, "fork failed: $!\n");
	}

	if ($pid == 0) {
		if ($env) {
			for my $key (keys %$env) {
				$ENV{$key} = $env->{$key} if defined $env->{$key};
			}
		}
		open STDERR, ">&STDOUT";
		exec @cmd or do {
			my $err = $!;
			print "exec @cmd failed: $err\n";
			exit 127;
		};
	}

	local $/;
	my $out = <$fh>;
	close $fh;
	my $status = $?;
	my $rc = $status == -1 ? 127 : ($status >> 8);
	return ($rc, sanitize($out));
}

sub collect_cmd {
	my ($ctx, $title, @cmd) = @_;
	my ($rc, $out) = run_cmd(undef, @cmd);
	raw_section($ctx, $title, $rc, $out);
	return ($rc, $out);
}

sub parse_derive_output {
	my ($text) = @_;
	my %out;

	for my $line (split /\n/, $text) {
		next unless $line =~ /^([A-Z][A-Z0-9_]*)=(.*)$/;
		$out{$1} = parse_shell_value($2);
	}

	return %out;
}

sub find_derive_command {
	my ($opt) = @_;
	return $opt->{derive_command} if $opt->{derive_command};

	my $same_dir = "$FindBin::Bin/mape-derive";
	return $same_dir if -x $same_dir;
	return "/usr/local/sbin/mape-derive";
}

sub mape_portset {
	my ($offset, $psid_len, $psid) = @_;
	die "invalid PSID_OFFSET\n" unless defined $offset && $offset =~ /^\d+$/ && $offset <= 15;
	die "invalid PSID_LEN\n" unless defined $psid_len && $psid_len =~ /^\d+$/ && $psid_len <= 16;
	die "invalid PSID\n" unless defined $psid && $psid =~ /^\d+$/;

	my $shift = 16 - $offset - $psid_len;
	die "invalid MAP-E port set: offset + psid_len exceeds 16\n" if $shift < 0;
	die "invalid MAP-E port set: PSID too large\n" if $psid_len > 0 && $psid >= (1 << $psid_len);
	die "invalid MAP-E port set: PSID must be 0 when PSID_LEN is 0\n" if $psid_len == 0 && $psid != 0;

	my $block = 1 << $shift;
	my $range_count = 1 << $offset;
	my @ranges;
	my @usable;

	for my $high (0 .. $range_count - 1) {
		my $start = ($high << ($psid_len + $shift)) | ($psid << $shift);
		my $end = $start + $block - 1;
		push @ranges, [$start, $end];

		my $u_start = $start < 1024 ? 1024 : $start;
		push @usable, [$u_start, $end] if $u_start <= $end;
	}

	my $usable_ports = 0;
	for my $r (@usable) {
		$usable_ports += $r->[1] - $r->[0] + 1;
	}

	return {
		shift => $shift,
		block_size => $block,
		range_count => $range_count,
		ports_total => $range_count * $block,
		ports_usable_ge1024 => $usable_ports,
		ranges => \@ranges,
		usable_ranges => \@usable,
	};
}

sub ranges_to_string {
	my ($ranges) = @_;
	return join ",", map { $_->[0] == $_->[1] ? $_->[0] : "$_->[0]-$_->[1]" } @$ranges;
}

sub unique {
	my @out;
	my %seen;
	for my $item (@_) {
		next unless defined $item && $item ne "";
		next if $seen{$item}++;
		push @out, $item;
	}
	return @out;
}

sub default_interfaces {
	my ($conf, $opt) = @_;
	return unique(@{$opt->{iface}}) if $opt->{iface} && @{$opt->{iface}};
	return unique($conf->{GIF_IF} || "gif0", $conf->{VLAN_IF} || "vlan835", $conf->{WAN_IF} || "pppoe0");
}

sub parse_ifconfig {
	my ($text) = @_;
	my %m = (
		inet => [],
		inet6 => [],
		groups => [],
	);

	for my $line (split /\n/, $text) {
		if ($line =~ /^(\S+):\s+flags=\d+<([^>]*)>\s+mtu\s+(\d+)/) {
			$m{name} = $1;
			$m{flags} = $2;
			$m{mtu} = $3;
			my %flags = map { $_ => 1 } split /,/, $2;
			$m{up} = $flags{UP} ? 1 : 0;
			$m{running} = $flags{RUNNING} ? 1 : 0;
		} elsif ($line =~ /^\s+index\s+(\d+)\s+priority\s+(\d+)/) {
			$m{index} = $1;
			$m{priority} = $2;
		} elsif ($line =~ /^\s+lladdr\s+(\S+)/) {
			$m{lladdr} = $1;
		} elsif ($line =~ /^\s+groups:\s+(.+)/) {
			push @{$m{groups}}, split /\s+/, trim($1);
		} elsif ($line =~ /^\s+inet\s+(\S+)/) {
			push @{$m{inet}}, $1;
		} elsif ($line =~ /^\s+inet6\s+(\S+)\s+prefixlen\s+(\d+)/) {
			push @{$m{inet6}}, "$1/$2";
		} elsif ($line =~ /^\s+tunnel(?:\s+\S+)?\s+(\S+)\s+-->\s+(\S+)/) {
			$m{tunnel_src} = $1;
			$m{tunnel_dst} = $2;
		} elsif ($line =~ /^\s+dev:\s+(\S+)\s+state:\s+(.+)/) {
			$m{pppoe_dev} = $1;
			$m{pppoe_state} = trim($2);
		} elsif ($line =~ /^\s+sid:\s+(\S+)/) {
			$m{pppoe_sid} = $1;
		} elsif ($line =~ /^\s+sppp:\s+phase\s+(\S+)/) {
			$m{sppp_phase} = $1;
		}
	}

	return %m;
}

sub emit_ifconfig_metrics {
	my ($ctx, $iface, $text, $rc) = @_;
	metric($ctx, "iface.$iface.exists", $rc == 0 ? 1 : 0);
	return if $rc != 0;

	my %m = parse_ifconfig($text);
	for my $key (qw(flags mtu up running index priority lladdr tunnel_src tunnel_dst pppoe_dev pppoe_state pppoe_sid sppp_phase)) {
		metric($ctx, "iface.$iface.$key", $m{$key}) if defined $m{$key};
	}
	metric($ctx, "iface.$iface.inet", join(",", @{$m{inet}})) if @{$m{inet}};
	metric($ctx, "iface.$iface.inet6", join(",", @{$m{inet6}})) if @{$m{inet6}};
	metric($ctx, "iface.$iface.groups", join(",", @{$m{groups}})) if @{$m{groups}};
}

sub parse_route_get {
	my ($text) = @_;
	my %m;

	for my $line (split /\n/, $text) {
		next unless $line =~ /^\s*([A-Za-z][A-Za-z0-9 _-]*):\s+(.+?)\s*$/;
		my ($key, $value) = ($1, $2);
		$key = lc trim($key);
		$key =~ s/\s+/_/g;
		$m{$key} = $value;
	}

	return %m;
}

sub emit_route_metrics {
	my ($ctx, $prefix, $text, $rc) = @_;
	metric($ctx, "$prefix.exists", $rc == 0 ? 1 : 0);
	return if $rc != 0;

	my %m = parse_route_get($text);
	for my $key (qw(destination gateway interface if_address priority flags mtu expire)) {
		metric($ctx, "$prefix.$key", $m{$key}) if defined $m{$key};
	}
}

sub parse_netstat_interface {
	my ($text, $iface) = @_;
	my @headers;
	my %m;

	for my $line (split /\n/, $text) {
		if ($line =~ /^Name\s+Mtu\s+/) {
			@headers = map { lc $_ } split /\s+/, trim($line);
			next;
		}
		next unless @headers;
		next unless $line =~ /^\Q$iface\E\s+/;

		my @cols = split /\s+/, trim($line);
		next unless @cols >= @headers;
		for my $i (0 .. $#headers) {
			my $name = $headers[$i];
			next if $name =~ /^(name|mtu|network|address)$/;
			$m{$name} = $cols[$i] if defined $cols[$i] && $cols[$i] =~ /^\d+$/;
		}
		last;
	}

	return %m;
}

sub emit_netstat_interface_metrics {
	my ($ctx, $iface, $text, $rc) = @_;
	return if $rc != 0;
	my %m = parse_netstat_interface($text, $iface);
	for my $key (sort keys %m) {
		metric($ctx, "iface.$iface.netstat.$key", $m{$key});
	}
}

sub parse_netstat_default_routes {
	my ($text) = @_;
	my @routes;
	for my $line (split /\n/, $text) {
		next unless $line =~ /^default\s+(\S+)\s+/;
		push @routes, $1;
	}
	return @routes;
}

sub parse_ndp_counts {
	my ($text) = @_;
	my %count;
	for my $line (split /\n/, $text) {
		next if $line =~ /^\s*(?:Neighbor|$)/;
		my @cols = split /\s+/, trim($line);
		next unless @cols >= 3;
		my $if = $cols[2];
		$count{$if}++;
	}
	return %count;
}

sub read_tail_filtered {
	my ($path, $lines, $pattern) = @_;
	return (1, "not readable\n") unless -r $path;
	open my $fh, "<", $path or return (1, "cannot read $path: $!\n");

	my @ring;
	while (my $line = <$fh>) {
		push @ring, $line;
		shift @ring while @ring > $lines;
	}
	close $fh;

	my $out = join "", grep { /$pattern/i } @ring;
	$out = "no matching lines in last $lines lines\n" if $out eq "";
	return (0, $out);
}

sub collect_config_metrics {
	my ($ctx, $conf_path, $conf) = @_;
	metric($ctx, "collector.version", $VERSION);
	metric($ctx, "time.utc", $ctx->{iso_utc});
	metric($ctx, "host.name", $ctx->{host});
	metric($ctx, "config.path", $conf_path);

	for my $key (qw(WAN_IF GIF_IF VLAN_IF PD_IF LEASE_FILE MAP_IPV6_PREFIX MAP_IPV6_PLEN MAP_IPV4_PREFIX MAP_IPV4_PLEN EA_LEN PSID_OFFSET BR_IPV6 MAPE_PEER_IPV4 GIF_MTU)) {
		metric($ctx, "config.$key", $conf->{$key}) if exists $conf->{$key};
	}
}

sub collect_derive_metrics {
	my ($ctx, $conf, $opt) = @_;
	my $derive = find_derive_command($opt);
	my ($rc, $out) = run_cmd($conf, $derive);
	raw_section($ctx, "mape-derive", $rc, $out);
	metric($ctx, "mape.derive_ok", $rc == 0 ? 1 : 0);
	return if $rc != 0;

	my %d = parse_derive_output($out);
	for my $key (qw(PD_PREFIX CE_IPV6 MAPE_IPV4 PSID_OFFSET PSID_LEN PSID)) {
		metric($ctx, "mape.$key", $d{$key}) if exists $d{$key};
	}

	if (defined $d{PSID_OFFSET} && defined $d{PSID_LEN} && defined $d{PSID}) {
		my $portset = eval { mape_portset($d{PSID_OFFSET}, $d{PSID_LEN}, $d{PSID}) };
		if ($@) {
			metric($ctx, "mape.portset.error", trim($@));
		} else {
			metric($ctx, "mape.portset.shift", $portset->{shift});
			metric($ctx, "mape.portset.block_size", $portset->{block_size});
			metric($ctx, "mape.portset.range_count", $portset->{range_count});
			metric($ctx, "mape.portset.ports_total", $portset->{ports_total});
			metric($ctx, "mape.portset.ports_usable_ge1024", $portset->{ports_usable_ge1024});
			metric($ctx, "mape.portset.ranges", ranges_to_string($portset->{ranges}));
			metric($ctx, "mape.portset.usable_ranges", ranges_to_string($portset->{usable_ranges}));
		}
	}
}

sub collect_interface_metrics {
	my ($ctx, @interfaces) = @_;

	for my $iface (@interfaces) {
		my ($rc_if, $ifconfig) = collect_cmd($ctx, "ifconfig -v $iface", "ifconfig", "-v", $iface);
		emit_ifconfig_metrics($ctx, $iface, $ifconfig, $rc_if);

		my ($rc_ns, $netstat) = collect_cmd($ctx, "netstat -n -I $iface -b -d", "netstat", "-n", "-I", $iface, "-b", "-d");
		emit_netstat_interface_metrics($ctx, $iface, $netstat, $rc_ns);

		if ($iface =~ /^pppoe/) {
			collect_cmd($ctx, "spppcontrol $iface", "spppcontrol", $iface);
		}
	}
}

sub collect_route_metrics {
	my ($ctx) = @_;

	my ($rc4, $route4) = collect_cmd($ctx, "route -n get default", "route", "-n", "get", "default");
	emit_route_metrics($ctx, "route.inet.default", $route4, $rc4);

	my ($rc6, $route6) = collect_cmd($ctx, "route -n get -inet6 default", "route", "-n", "get", "-inet6", "default");
	emit_route_metrics($ctx, "route.inet6.default", $route6, $rc6);

	my ($rc_ns6, $ns6) = collect_cmd($ctx, "netstat -rn -f inet6", "netstat", "-rn", "-f", "inet6");
	if ($rc_ns6 == 0) {
		my @defaults = parse_netstat_default_routes($ns6);
		metric($ctx, "route.inet6.default.count", scalar @defaults);
		metric($ctx, "route.inet6.default.gateways", join(",", @defaults)) if @defaults;
	}

	my ($rc_ns4, $ns4) = collect_cmd($ctx, "netstat -rn -f inet", "netstat", "-rn", "-f", "inet");
	if ($rc_ns4 == 0) {
		my @defaults = parse_netstat_default_routes($ns4);
		metric($ctx, "route.inet.default.count", scalar @defaults);
		metric($ctx, "route.inet.default.gateways", join(",", @defaults)) if @defaults;
	}
}

sub collect_ipv6_metrics {
	my ($ctx, @interfaces) = @_;

	for my $name (qw(
		net.inet6.ip6.forwarding
		net.inet6.ip6.accept_rtadv
		net.inet6.ip6.dad_count
		net.inet6.ip6.hlim
		net.inet6.ip6.maxfragpackets
		net.inet.ip.forwarding
		net.inet.ip.mtudisc
	)) {
		my ($rc, $out) = collect_cmd($ctx, "sysctl $name", "sysctl", $name);
		if ($rc == 0 && $out =~ /^\Q$name\E=(.+)$/m) {
			metric($ctx, "sysctl.$name", trim($1));
		}
	}

	my ($rc_ndp, $ndp) = collect_cmd($ctx, "ndp -an", "ndp", "-an");
	if ($rc_ndp == 0) {
		my %counts = parse_ndp_counts($ndp);
		for my $iface (@interfaces) {
			metric($ctx, "ndp.$iface.neighbor_count", $counts{$iface} || 0);
		}
	}
}

sub collect_pf_metrics {
	my ($ctx) = @_;

	my ($rc_info, $info) = collect_cmd($ctx, "pfctl -s info", "pfctl", "-s", "info");
	if ($rc_info == 0) {
		metric($ctx, "pf.enabled", $info =~ /^Status:\s+Enabled\b/m ? 1 : 0);
		if ($info =~ /^State Table\s+Total\s+Rate\s*\n\s+current entries\s+(\d+)/m) {
			metric($ctx, "pf.state_entries", $1);
		}
	}

	my ($rc_rules, $rules) = collect_cmd($ctx, "pfctl -a mape -sr", "pfctl", "-a", "mape", "-sr");
	if ($rc_rules == 0) {
		my $rule_count = scalar grep { /\S/ } split /\n/, $rules;
		metric($ctx, "pf.mape_anchor.rules", $rule_count);
		metric($ctx, "pf.mape_anchor.has_map_e_portset", $rules =~ /map-e-portset/ ? 1 : 0);
	}
}

sub collect_lease_metrics {
	my ($ctx, $conf) = @_;
	my $lease = $conf->{LEASE_FILE};
	return unless defined $lease && $lease ne "";

	my ($rc, $text) = read_text_file($lease, 300);
	raw_section($ctx, "lease file $lease", $rc, $text);
	metric($ctx, "lease.file", $lease);
	metric($ctx, "lease.readable", $rc == 0 ? 1 : 0);
	return if $rc != 0;

	my @prefixes = $text =~ /([0-9a-fA-F:]+\/\d{1,3})/g;
	metric($ctx, "lease.prefix_count", scalar @prefixes);
	metric($ctx, "lease.prefixes", join(",", unique(@prefixes))) if @prefixes;
}

sub collect_logs {
	my ($ctx, $tail_lines) = @_;
	my $pattern = qr/gif0|vlan835|pppoe0|dhcp6|dhcpleased|slaacd|map-e|mape|prefix|delegat|route|wan/i;

	for my $file ("/var/log/daemon", "/var/log/messages") {
		my ($rc, $out) = read_tail_filtered($file, $tail_lines, $pattern);
		raw_section($ctx, "recent syslog $file", $rc, $out);
	}
}

sub state_metric {
	my ($name) = @_;
	return 1 if $name =~ /^mape\./;
	return 1 if $name =~ /^config\.(?:WAN_IF|GIF_IF|VLAN_IF|PD_IF|MAP_|EA_LEN|PSID_OFFSET|BR_IPV6|MAPE_PEER_IPV4|GIF_MTU)/;
	return 1 if $name =~ /^iface\.[^.]+\.(?:exists|flags|mtu|up|running|inet|inet6|groups|tunnel_src|tunnel_dst|pppoe_state|sppp_phase)$/;
	return 1 if $name =~ /^route\./;
	return 1 if $name =~ /^sysctl\./;
	return 1 if $name =~ /^lease\.(?:readable|prefix_count|prefixes)$/;
	return 0;
}

sub write_metrics_file {
	my ($path, $metrics) = @_;
	open my $fh, ">", $path or die "mape-metrics: cannot write $path: $!\n";
	for my $m (@$metrics) {
		print {$fh} "$m->[0]\t", escape_value($m->[1]), "\n";
	}
	close $fh;
}

sub write_raw_file {
	my ($path, $raw) = @_;
	open my $fh, ">", $path or die "mape-metrics: cannot write $path: $!\n";
	for my $s (@$raw) {
		print {$fh} "\n===== $s->[0] =====\n";
		print {$fh} "exit=$s->[1]\n";
		print {$fh} $s->[2];
		print {$fh} "\n" unless $s->[2] =~ /\n\z/;
	}
	close $fh;
}

sub write_state_file {
	my ($path, $metrics) = @_;
	open my $fh, ">", $path or die "mape-metrics: cannot write $path: $!\n";
	for my $m (sort { $a->[0] cmp $b->[0] } grep { state_metric($_->[0]) } @$metrics) {
		print {$fh} "$m->[0]\t", escape_value($m->[1]), "\n";
	}
	close $fh;
}

sub file_text {
	my ($path) = @_;
	return "" unless -r $path;
	open my $fh, "<", $path or return "";
	local $/;
	my $text = <$fh>;
	close $fh;
	return $text // "";
}

sub write_diff {
	my ($old_path, $new_path, $diff_path) = @_;
	my ($rc, $out) = run_cmd(undef, "diff", "-u", $old_path, $new_path);
	return 0 if $rc == 0;
	open my $fh, ">", $diff_path or die "mape-metrics: cannot write $diff_path: $!\n";
	print {$fh} $out;
	close $fh;
	return 1;
}

sub append_index {
	my ($path, $row) = @_;
	my $need_header = !-f $path;
	open my $fh, ">>", $path or die "mape-metrics: cannot write $path: $!\n";
	if ($need_header) {
		print {$fh} join("\t", qw(utc_time host changed metrics raw state diff)), "\n";
	}
	print {$fh} join("\t", map { defined $_ ? $_ : "-" } @$row), "\n";
	close $fh;
}

sub collect_all {
	my ($conf_path, $conf, $opt) = @_;
	my $ts = now_utc();
	my $iso = now_iso_utc();
	my ($rc_host, $host_out) = run_cmd(undef, "hostname");
	my $host = $rc_host == 0 ? trim($host_out) : "unknown";
	my @interfaces = default_interfaces($conf, $opt);

	my %ctx = (
		metrics => [],
		raw => [],
		raw_enabled => $opt->{raw},
		host => $host,
		ts => $ts,
		iso_utc => $iso,
	);

	collect_config_metrics(\%ctx, $conf_path, $conf);
	metric(\%ctx, "collector.interfaces", join(",", @interfaces));
	collect_derive_metrics(\%ctx, $conf, $opt);
	collect_interface_metrics(\%ctx, @interfaces);
	collect_route_metrics(\%ctx);
	collect_ipv6_metrics(\%ctx, @interfaces);
	collect_pf_metrics(\%ctx);
	collect_lease_metrics(\%ctx, $conf);
	collect_logs(\%ctx, $opt->{tail_lines});

	return \%ctx;
}

sub acquire_lock {
	my ($state_dir) = @_;
	my $lock = "$state_dir/lock";
	return $lock if mkdir $lock;
	return;
}

sub release_lock {
	my ($lock) = @_;
	rmdir $lock if defined $lock;
}

sub main {
	umask 077;

	my %opt = (
		conf => $ENV{MAPE_CONF} || "/etc/mape.conf",
		log_dir => $ENV{MAPE_METRICS_LOGDIR} || "/var/log/mape-watch",
		state_dir => $ENV{MAPE_METRICS_STATEDIR} || "/var/db/mape-watch",
		tail_lines => $ENV{MAPE_METRICS_TAIL_LINES} || 250,
		raw => 1,
		iface => [],
	);

	GetOptions(
		"conf|c=s" => \$opt{conf},
		"log-dir|o=s" => \$opt{log_dir},
		"state-dir=s" => \$opt{state_dir},
		"iface=s@" => \$opt{iface},
		"derive-command=s" => \$opt{derive_command},
		"tail-lines=i" => \$opt{tail_lines},
		"stdout" => \$opt{stdout},
		"no-raw" => sub { $opt{raw} = 0 },
		"help" => \$opt{help},
	) or die usage();

	if ($opt{help}) {
		print usage();
		return 0;
	}

	make_path($opt{log_dir}, $opt{state_dir});
	my $lock = acquire_lock($opt{state_dir});
	return 0 unless defined $lock;

	my $ok = eval {
		my %conf = parse_conf_file($opt{conf});
		my $ctx = collect_all($opt{conf}, \%conf, \%opt);
		my $base = "$opt{log_dir}/$ctx->{host}-$ctx->{ts}";
		my $metrics_path = "$base.metrics";
		my $raw_path = "$base.raw";
		my $state_path = "$base.state";
		my $diff_path = "$base.diff";
		my $last_state = "$opt{state_dir}/last.state";

		write_metrics_file($metrics_path, $ctx->{metrics});
		write_raw_file($raw_path, $ctx->{raw}) if $opt{raw};
		write_state_file($state_path, $ctx->{metrics});

		my $changed = "first";
		if (-f $last_state) {
			if (file_text($last_state) eq file_text($state_path)) {
				$changed = "no";
				unlink $diff_path if -f $diff_path;
			} else {
				$changed = write_diff($last_state, $state_path, $diff_path) ? "yes" : "no";
			}
		}

		unlink $last_state if -f $last_state;
		link $state_path, $last_state or do {
			open my $in, "<", $state_path or die "cannot read $state_path: $!\n";
			open my $out, ">", $last_state or die "cannot write $last_state: $!\n";
			print {$out} $_ while <$in>;
			close $out;
			close $in;
		};

		metric($ctx, "collector.changed", $changed);
		write_metrics_file($metrics_path, $ctx->{metrics});

		append_index("$opt{log_dir}/index.tsv", [
			$ctx->{ts},
			$ctx->{host},
			$changed,
			$metrics_path,
			$opt{raw} ? $raw_path : "-",
			$state_path,
			-f $diff_path ? $diff_path : "-",
		]);

		if ($opt{stdout}) {
			for my $m (@{$ctx->{metrics}}) {
				print "$m->[0]\t", escape_value($m->[1]), "\n";
			}
		}
		1;
	};
	my $err = $@;
	release_lock($lock);

	die $err unless $ok;
	return 0;
}

MapeMetrics::main(@ARGV) unless caller;
1;
